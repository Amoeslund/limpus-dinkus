{
  "name": "limpus-dinkus",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "loremforever.com", "custom_domain": true },
    { "pattern": "www.loremforever.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "limpus",
      // PLACEHOLDER: run `npx wrangler d1 create limpus` and paste the real id here before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
