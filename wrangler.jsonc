{
  "name": "limpus-dinkus",
  "main": "src/index.tsx",
  // Static files (logo, favicon) are served before the Worker runs, except /officer/* (addon downloads),
  // which goes through the Worker so only logged-in officers get it.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/officer/*"] },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Armory roster poll (see src/db/roster.ts).
  "triggers": { "crons": ["17 */3 * * *"] },
  "routes": [
    { "pattern": "loremforever.com", "custom_domain": true },
    { "pattern": "www.loremforever.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "limpus",
      "database_id": "f1fec3a9-0a21-4727-b14f-65caba1d62ca",
      "migrations_dir": "migrations"
    }
  ]
}
